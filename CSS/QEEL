/* ===== QEEL =====*/

/* sécurité */
#qeel-source-wrapper.qeel-attente{visibility:hidden;}
#qeel-source-wrapper.qeel-pret{visibility:visible;}
#qeel-recepteur{ margin-top:24px; clear:both; }

.qeel{
  --qeel-h:300px;
  --qeel-l-tirage:145px;
  --qeel-carte-l:78px;
  --qeel-carte-h:126px;
  background-color:var(--neutral);
  border:var(--border);border-radius:10px;
  padding:18px 20px;margin:0 0 20px;color:var(--textColor);
}

.qeel-scene{display:flex;align-items:stretch;gap:0;}

/* --- colonnes cartes --- */
.qeel-tirage{
  position:relative;flex:0 0 var(--qeel-l-tirage);height:var(--qeel-h);
  z-index:auto;
}
.qeel-groupe{
  position:absolute;left:var(--x);top:var(--y);
  width:var(--qeel-carte-l);height:var(--qeel-carte-h);
  z-index:var(--z,1);transform:rotate(calc(90deg + var(--rot)));transform-origin:center;
  text-decoration:none;transition:transform 160ms ease;
}

.qeel-groupe:hover,
.qeel-groupe:focus{
  z-index:30;
  transform:rotate(calc(90deg + var(--rot))) translateY(-7px) scale(1.07);
}

.qeel-groupe::before{
  content:"";
  position:absolute;
  inset:0;
  border-radius:5px;
  background:var(--neutral);
  box-shadow:0 3px 8px rgba(0,0,0,.30);
}

.qeel-carte{
  position:relative;
  display:block;width:100%;height:100%;background-color:currentColor;
  -webkit-mask-repeat:no-repeat;mask-repeat:no-repeat;
  -webkit-mask-position:center;mask-position:center;
  -webkit-mask-size:178% auto;mask-size:178% auto;
}
.qeel-carte:hover{
  z-index: 99;
}

.qeel-bulle{
  --d:calc(var(--qeel-carte-h) / 2 + 22px);
  position:absolute;left:50%;top:50%;
  transform:translate(-50%,-50%) rotate(calc(-90deg - var(--rot))) translateY(calc(-1 * var(--d)));
  z-index:40;white-space:nowrap;pointer-events:none;
  opacity:0;visibility:hidden;transition:opacity 120ms ease;
  background:var(--neutralDark);color:var(--textColor);
  border:var(--border);border-radius:6px;padding:5px 9px;font-size:11px;line-height:1.3;
  box-shadow:0 4px 14px rgba(0,0,0,.18);
}
.qeel-groupe:hover .qeel-bulle,
.qeel-groupe:focus .qeel-bulle{opacity:1;visibility:visible;pointer-events:auto;}
.qeel-bulle b{font-weight:600;color:currentColor;}
.qeel-bulle .qeel-hex{
  font-family:monospace;font-size:11px;letter-spacing:.02em;
  cursor:pointer;border-bottom:1px dotted;
}

/* à modifier dans :root pour les couleurs mici */
.qeel-groupe.grp-1{color:var(--grp-1);}
.qeel-groupe.grp-2{color:var(--grp-2);}
.qeel-groupe.grp-3{color:var(--grp-3);}
.qeel-groupe.grp-4{color:var(--grp-4);}
.qeel-groupe.grp-5{color:var(--grp-5);}
.qeel-groupe.grp-6{color:var(--grp-6);}

.qeel-groupe.grp-1 .qeel-carte{-webkit-mask-image:var(--qeel-carte-1);mask-image:var(--qeel-carte-1);}
.qeel-groupe.grp-2 .qeel-carte{-webkit-mask-image:var(--qeel-carte-2);mask-image:var(--qeel-carte-2);}
.qeel-groupe.grp-3 .qeel-carte{-webkit-mask-image:var(--qeel-carte-3);mask-image:var(--qeel-carte-3);}
.qeel-groupe.grp-4 .qeel-carte{-webkit-mask-image:var(--qeel-carte-4);mask-image:var(--qeel-carte-4);}
.qeel-groupe.grp-5 .qeel-carte{-webkit-mask-image:var(--qeel-carte-5);mask-image:var(--qeel-carte-5);}
.qeel-groupe.grp-6 .qeel-carte{-webkit-mask-image:var(--qeel-carte-6);mask-image:var(--qeel-carte-6);}

.qeel-blocs{
  flex:1 1 auto;min-width:0;
  height:var(--qeel-h);
  display:grid;
 grid-template-columns:minmax(0,1fr) minmax(0,1fr) minmax(0,.62fr);
  grid-template-rows:minmax(0, 1fr) auto;
  gap:12px;
  position:relative;
  z-index:10;
}

.qeel-panneau{
  background:var(--neutralDark);
  border:var(--border);border-radius:8px;
  padding:11px 13px;
  display:flex;flex-direction:column;min-width:0;min-height:0;
}

.qeel-panneau-titre{
  display:flex;align-items:baseline;justify-content:space-between;gap:8px;
  font-size:var(--little-size);font-weight:700;letter-spacing:.06em;
  text-transform:uppercase;color:var(--accentClr);
  padding-bottom:6px;margin-bottom:7px;border-bottom:var(--border);
}

.qeel-compte{
  background:var(--neutralDarker);color:var(--contrast);
  border-radius:5px;padding:1px 7px;font-size:11px;letter-spacing:0;
}

.qeel-liste{
  font-size:var(--little-size);line-height:1.7;
  flex:1 1 auto;min-height:0;
  overflow-y:auto;overscroll-behavior:contain;
  scrollbar-width:thin;scrollbar-color:var(--neutralDarker) transparent;padding-right:5px;
}
.qeel-liste a{text-decoration:none;}
.qeel-liste a:hover{text-decoration:underline;}

.qeel-vide{opacity:.6;font-style:italic;}

.qeel-stats{
  flex:1 1 auto;display:flex;flex-direction:column;
  justify-content:space-around;gap:6px;
}
.qeel-stat{
  display:flex;
  flex-direction:column;
  align-items:flex-start;
  gap:0;
}
.qeel-stat b{
  font-family:"Playfair Display",Georgia,serif;
  font-size:26px;line-height:1;font-weight:700;color:var(--contrast);
  min-width:2ch;
}

.qeel-stat span{font-size:var(--little-size);letter-spacing:.07em;text-transform:uppercase;opacity:.8;}
.qeel-inscrit{
  grid-column:1 / -1;
  flex-direction:row;align-items:center;gap:14px;
}

.qeel-avatar{
  flex:0 0 auto;width:46px;height:46px;border-radius:50%;overflow:hidden;
  border:var(--border);background:var(--neutralDarker);
}
.qeel-avatar:empty{display:none;}
.qeel-avatar img{width:100%;height:100%;object-fit:cover;display:block;}

.qeel-inscrit-txt{
  display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 12px;min-width:0;
}

.qeel-inscrit .accueil{font-size:var(--medium-size);}

.qeel-inscrit #qeel-newest,
.qeel-inscrit #qeel-newest a{font-weight:700;text-decoration:none;}

.qeel-inscrit em{
  font-family:"Playfair Display",Georgia,serif;
  font-style:italic;font-size:var(--medium-size);opacity:.85;
}

@media (max-width:1000px){
  .qeel-blocs{ grid-template-columns:repeat(2, minmax(0, 1fr)); }
  .qeel-panneau-stats{ grid-column:1 / -1; }
  .qeel-stats{ flex-direction:row; justify-content:space-around; }
}

@media (max-width:560px){
  .qeel-blocs{grid-template-columns:1fr;}
  .qeel-inscrit{flex-wrap:wrap;}
}


/* copyright et fin du forum */
#bottom .right{ font-size:10px; line-height:1.7; opacity:.75; }

/* ===== CATEGORIES ET FORUMS ===== */

.ctl-categorie{
  --ctl-trait: var(--neutralDarker);
  --ctl-pouce: var(--neutralDarker);
  --ctl-titre: 'Outfit', Arial, Tahoma, serif;
  --ctl-l-sousforums:170px;
  --ctl-l-dernier:130px;
  --ctl-l-avatar:104px;
  --ctl-l-statut:34px;
  --ctl-fond-position:center;
  --ctl-fond-taille:auto;
  --ctl-bloc-opacite:88%;
  --ctl-bloc-fond:color-mix(in srgb, var(--neutralDark) var(--ctl-bloc-opacite), transparent);
  margin:0 0 26px;
}

.ctl-cat-titre{
  display:flex;align-items:center;gap:20px;
  font-family:var(--ctl-titre);
  font-weight:600; font-variant:small-caps; letter-spacing:.04em;
  font-size:36px;line-height:1.1;color:var(--contrast);
  gap:20px;
  margin:0 0 14px;
  padding:10px 28px;
  background-color:var(--neutralDark);
  background-image:var(--ctl-titre-fond);
  background-repeat:no-repeat;
  background-position:center;
  background-size:cover;
  border-radius:7px;
}

.ctl-cat-titre h2{margin:0;font:inherit;color:inherit;letter-spacing:inherit;}
.ctl-cat-titre::before,
.ctl-cat-titre::after{
  content:"";flex:1 1 auto;height:1px;background:var(--ctl-trait);
}

.ctl-forums{
  list-style:none;margin:0;
  padding:14px 16px 16px;
  background:var(--neutralDark);
  border-radius:7px;
}

.ctl-forum{
  position:relative;
  display:flex;align-items:center;justify-content:space-between;gap:14px;
  border-radius:5px;padding:0 16px;margin:24px 0 14px;height:145px;
  background-color:var(--neutral);
  background-repeat:no-repeat;
  background-position:var(--ctl-fond-position);
  background-size:var(--ctl-fond-taille);
}

.ctl-forum:last-child{margin-bottom:0;}

.ctl-forum-titre{
  position:absolute;top:-17px;left:24px;margin:0;z-index:2;
  font-family:var(--ctl-titre);
  font-weight:600;
  font-size:27px;line-height:1;letter-spacing:.3px;
}

.ctl-forum-titre a{color:var(--contrast);text-decoration:none;}

.ctl-forum-titre a:hover{color:var(--accentClr);}

.ctl-desc,.ctl-sousforums{
  overflow-y:auto;overscroll-behavior:contain;
  scrollbar-width:thin;scrollbar-color:var(--ctl-pouce) transparent;
}

.ctl-desc::-webkit-scrollbar,.ctl-sousforums::-webkit-scrollbar{width:6px;}

.ctl-desc::-webkit-scrollbar-track,.ctl-sousforums::-webkit-scrollbar-track{background:transparent;}

.ctl-desc::-webkit-scrollbar-thumb,.ctl-sousforums::-webkit-scrollbar-thumb{background:var(--ctl-pouce);border-radius:3px;}

.ctl-col-gauche{flex:1 1 auto;min-width:0;max-width:520px;height:120px;margin-top:5px;display:flex;}

.ctl-desc{
  flex:1 1 auto;height:100%;
  background:var(--ctl-bloc-fond);border-radius:8px;padding:10px 12px;
  font-size:12px;line-height:1.3;color:var(--textColor);
}

.ctl-statut{
  flex:0 0 var(--ctl-l-statut);
  height:120px;margin-top:5px;
  background:transparent;pointer-events:none;
}

.ctl-panneau{
  flex:0 0 auto;display:flex;align-items:stretch;
  background:var(--ctl-bloc-fond);border-radius:4px;overflow:hidden;
  height:120px;margin-top:5px;
  min-width:calc(var(--ctl-l-sousforums) + var(--ctl-l-dernier) + var(--ctl-l-avatar));
}

.ctl-sousforums{
  flex:0 0 var(--ctl-l-sousforums);padding:9px 11px;
  display:flex;flex-direction:column;gap:5px;justify-content:flex-start;
}

.ctl-sousforums > a:first-child{margin-top:auto;}

.ctl-sousforums > a:last-child{margin-bottom:auto;}

.ctl-sousforums a{
  flex:0 0 auto;display:block;background:var(--neutralDarker);border-radius:5px;
  padding:4px 13px;font-size:9.5px;font-weight:700;letter-spacing:.6px;
  text-transform:uppercase;color:var(--contrast);text-decoration:none;
  text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}

.ctl-sousforums a:hover{background:var(--accentClr);color:var(--neutral);}

.ctl-dernier{
  flex:0 0 var(--ctl-l-dernier);padding:9px 12px;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  text-align:center;gap:2px;
}

.ctl-sujet{
  font-size:10.5px;font-weight:700;color:var(--textColor);text-decoration:none;
  display:block;max-width:100%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}

.ctl-sujet:hover{text-decoration:underline;}

.ctl-lastpost{display:flex;flex-direction:column;align-items:center;gap:1px;font-size:10.5px;}

.ctl-auteur{font-weight:700;text-transform:uppercase;letter-spacing:.3px;line-height:1.2;}

.ctl-auteur a{text-decoration:none;}

.ctl-date{font-size:9.5px;color:var(--textColor);opacity:.7;}

.ctl-compteurs{
  display:flex;gap:22px;margin-top:6px;padding-top:6px;
  border-top:1px solid var(--ctl-trait);width:100%;justify-content:center;
}

.ctl-compteurs span{display:flex;flex-direction:column;align-items:center;}

.ctl-compteurs b{font-family:var(--ctl-titre);font-size:16px;line-height:1;color:var(--contrast);}

.ctl-compteurs i{font-style:normal;font-size:8.5px;color:var(--textColor);opacity:.7;margin-top:2px;}

.ctl-avatar{
  flex:0 0 var(--ctl-l-avatar);overflow:hidden;
  -webkit-mask-image:linear-gradient(to right, transparent 0%, rgba(0,0,0,.55) 30%, #000 60%);
          mask-image:linear-gradient(to right, transparent 0%, rgba(0,0,0,.55) 30%, #000 60%);
}

.ctl-avatar img{width:100%;height:100%;display:block;object-fit:cover;object-position:center 18%;max-width:none;max-height:none;}

@media (max-width:1120px){
  :root{ --barre-h:104px; }
  .switcheroo[position="top"]{ height:52px; }
  .navbar{
    top:52px;height:52px;
    justify-content:flex-start;
    padding:0 10px;
    background:var(--neutral);
    pointer-events:auto;
    overflow-x:auto;overflow-y:hidden;
    scrollbar-width:none;
  }
  #notiffi_button,
  body #FAM-button-open,
  [data-theme-controls]{ top:9px; }
  .navbar::-webkit-scrollbar{ display:none; }
  .navbar li{ flex:0 0 auto; }
  .navbar a.mainmenu{ white-space:nowrap; }
}
@media (max-width:940px){
  .main_forum{ margin-left:10px;margin-right:10px; }
}
@media (max-width:600px){
  .main_forum{ padding:12px;margin-top:12px; }
}
